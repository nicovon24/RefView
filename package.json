{
  "name": "refview",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @refview/web dev",
    "build": "pnpm --filter @refview/web build",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:db": "pnpm --filter @refview/web test:db",
    "db:generate": "pnpm --filter @refview/web db:generate",
    "db:validate": "pnpm --filter @refview/web db:validate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.1"
  }
}
