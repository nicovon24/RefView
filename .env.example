# Local development databases. Create refview_test separately before integration tests.
DATABASE_URL="postgresql://refview_app:<local-app-secret>@127.0.0.1:55439/refview?schema=public"
TEST_DATABASE_URL="postgresql://refview:refview_local@127.0.0.1:55439/refview_test?schema=public"

# Exact application origin for private owner admission and mutations.
# Production requires HTTPS. Local HTTP is allowed only on loopback with an explicit port.
REFVIEW_APP_ORIGIN="http://127.0.0.1:3000"

# Only for the isolated, development-only anonymous-session transport preview.
# Start a separate local server with these values; never use this mode in production.
# REFVIEW_SESSION_TEST_MODE="1"
# REFVIEW_ORIGIN="http://127.0.0.1:3001"
