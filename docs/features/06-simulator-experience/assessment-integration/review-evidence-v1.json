      "reviewedSource": {
        "schemaVersion": 1,
        "itemId": "careless-trip-penalty-restart",
        "version": 1,
        "lawsEdition": "IFAB-2026-27",
        "topicId": "challenge",
        "level": "beginner",
        "localized": {
          "es": {
            "title": "Zancadilla imprudente en el área",
            "prompt": "Según los hechos escritos, ¿debe detenerse el juego, cuál es la reanudación, hay sanción disciplinaria y quién cometió la infracción?"
          },
          "en": {
            "title": "Careless trip in the penalty area",
            "prompt": "Using the written facts, should play be stopped, what is the restart, is there a disciplinary sanction, and who committed the offence?"
          }
        },
        "publicEvidence": [
          {
            "evidenceId": "authored-facts",
            "text": {
              "es": "Caso ficticio escrito: el balón está en juego. defence-04 disputa el balón, no lo toca y zancadillea de forma imprudente a attack-09 dentro de su propia área penal. La acción no es temeraria ni usa fuerza excesiva. No hay otra conducta sancionable y los hechos no establecen una ocasión manifiesta de gol.",
              "en": "Written fictional case: the ball is in play. defence-04 challenges for the ball, does not touch it, and carelessly trips attack-09 inside the defender's own penalty area. The action is neither reckless nor excessive. There is no other card-worthy conduct, and the facts do not establish an obvious goal-scoring opportunity."
            }
          }
        ],
        "correction": {
          "correctionVersion": 1,
          "summary": {
            "es": "Penalti sin tarjeta para defence-04.",
            "en": "Penalty kick without a card for defence-04."
          },
          "explanation": {
            "es": "La zancadilla imprudente con el balón en juego es una infracción de tiro libre directo. Al cometerse dentro de la propia área penal, se sanciona con penalti. La imprudencia, sin otra conducta sancionable, no exige tarjeta; los hechos escritos tampoco establecen DOGSO.",
            "en": "A careless trip while the ball is in play is a direct-free-kick offence. Because it occurs inside the offender's own penalty area, the restart is a penalty kick. Carelessness alone, with no other card-worthy conduct, does not require a card; the written facts also do not establish DOGSO."
          },
          "evidenceIds": [
            "authored-facts"
          ],
