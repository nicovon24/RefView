      "reviewedSource": {
        "schemaVersion": 1,
        "itemId": "reckless-challenge-not-dogso",
        "version": 1,
        "lawsEdition": "IFAB-2026-27",
        "topicId": "challenge",
        "level": "intermediate",
        "localized": {
          "es": {
            "title": "Entrada temeraria sin DOGSO",
            "prompt": "Según los hechos escritos, decide si detener el juego, la reanudación, la sanción y el infractor. Explica brevemente por qué corresponde una amonestación aunque no haya DOGSO. La explicación se guarda para autoevaluación y no recibe puntuación automática."
          },
          "en": {
            "title": "Reckless challenge without DOGSO",
            "prompt": "Using the written facts, decide whether to stop play, the restart, the sanction, and the offender. Briefly explain why a caution applies even without DOGSO. Your explanation is saved for self-review and receives no automatic score."
          }
        },
        "publicEvidence": [
          {
            "evidenceId": "authored-facts",
            "text": {
              "es": "Caso ficticio escrito: defence-07 contacta a attack-11 al disputar el balón fuera del área penal de defence-07. Los hechos establecen una infracción temeraria de tiro libre directo, sin fuerza excesiva. La dirección no es directa hacia la portería, el control del balón es incierto y hay dos defensores que pueden intervenir: no hay ocasión manifiesta de gol. No existe otra conducta sancionable.",
              "en": "Written fictional case: defence-07 contacts attack-11 while challenging for the ball outside defence-07's penalty area. The facts establish a reckless direct-free-kick offence without excessive force. The direction is not directly towards goal, ball control is uncertain, and two covering defenders can intervene: there is no obvious goal-scoring opportunity. There is no other misconduct."
            }
          }
        ],
        "correction": {
          "correctionVersion": 1,
          "summary": {
            "es": "Tiro libre directo y amonestación a defence-07.",
            "en": "Direct free kick and caution for defence-07."
          },
          "explanation": {
            "es": "La infracción temeraria fuera del área exige tiro libre directo y amonestación. La tarjeta se debe a la temeridad por sí misma. La dirección, el control incierto y los dos defensores que pueden intervenir descartan DOGSO en estos hechos escritos; eso no elimina la amonestación.",
            "en": "The reckless offence outside the penalty area requires a direct free kick and caution. Recklessness itself warrants the card. The direction, uncertain control, and two covering defenders exclude DOGSO in these written facts; that does not remove the caution."
          },
          "evidenceIds": [
