      "reviewedSource": {
        "schemaVersion": 1,
        "itemId": "challenge-severity-rule",
        "version": 1,
        "lawsEdition": "IFAB-2026-27",
        "topicId": "challenge",
        "level": "beginner",
        "localized": {
          "es": {
            "title": "Entrada temeraria",
            "prompt": "Un defensor disputa el balón y el árbitro juzga que la entrada fue temeraria; hubo contacto con un adversario. ¿Qué combinación describe correctamente la Regla 12?"
          },
          "en": {
            "title": "Reckless challenge",
            "prompt": "A defender challenges for the ball and the referee judges the challenge reckless; it involved contact with an opponent. Which combination correctly applies Law 12?"
          }
        },
        "publicEvidence": [
          {
            "evidenceId": "severity-thresholds",
            "text": {
              "es": "La Regla 12 distingue una entrada imprudente, una temeraria que desatiende el peligro para un adversario y el uso de fuerza excesiva que pone en peligro su integridad.",
              "en": "Law 12 distinguishes a careless challenge, a reckless one that disregards danger to an opponent, and excessive force that endangers an opponent's safety."
            }
          }
        ],
        "correction": {
          "correctionVersion": 1,
          "summary": {
            "es": "Tiro libre directo y amonestación.",
            "en": "Direct free kick and caution."
          },
          "explanation": {
            "es": "Una entrada temeraria con contacto se sanciona con tiro libre directo y amonestación. Una entrada solo imprudente no exige tarjeta; el uso de fuerza excesiva corresponde a la expulsión.",
            "en": "A reckless challenge involving contact is punished by a direct free kick and caution. A merely careless challenge needs no card; excessive force calls for a sending-off."
          },
          "evidenceIds": [
            "severity-thresholds"
          ],
